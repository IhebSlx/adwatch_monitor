# ADWATCH_DB_URL=sqlite:///data/adwatch.db
LIVE_SOURCE=apify

APIFY_API_TOKEN=
APIFY_ACTOR_ID=
APIFY_RUN_TIMEOUT_SECONDS=180
APIFY_POLL_INTERVAL_SECONDS=3

# Google Ads Transparency Center scraper — same Apify account/token as above,
# just a different actor. Resolves advertisers by website domain (no name
# search available for Google, unlike Meta).
GOOGLE_ADS_ACTOR_ID=

SEARCHAPI_KEY=
SEARCHAPI_URL=https://www.searchapi.io/api/v1/search

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

ADWATCH_COUNTRY=DE

# Power Automate webhook that emails the report PDF. Treat this URL as a
# secret — anyone who has it can trigger the flow (send mail on your behalf).
POWER_AUTOMATE_WEBHOOK_URL=
REPORT_EMAIL_DEFAULT_RECIPIENT=
